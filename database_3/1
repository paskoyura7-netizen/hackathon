# --- API Функції для твого колеги (Фронтендера) ---

def get_all_subjects():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM subjects")
    data = cursor.fetchall()
    conn.close()
    return data

def get_student_calendar(student_id):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('''
        SELECT e.title, e.event_date, e.event_type, s.name, e.is_completed
        FROM events e
        JOIN subjects s ON e.subject_id = s.id
        WHERE e.student_id = ?
        ORDER BY e.event_date ASC
    ''', (student_id,))
    data = cursor.fetchall()
    conn.close()
    return data

# НОВЕ: Отримання розкладу пар по групі
def get_schedule_by_group(group_id, day_of_week=None):
    """Повертає розклад пар для групи. Можна вказати конкретний день тижня (1-5)."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    query = '''
        SELECT sch.day_of_week, sch.time_start, sch.time_end, s.name, sch.teacher, sch.room
        FROM schedule sch
        JOIN subjects s ON sch.subject_id = s.id
        WHERE sch.group_id = ?
    '''
    params = [group_id]
    
    if day_of_week:
        query += ' AND sch.day_of_week = ?'
        params.append(day_of_week)
        
    query += ' ORDER BY sch.day_of_week, sch.time_start'
    
    cursor.execute(query, params)
    data = cursor.fetchall()
    conn.close()
    return data

# НОВЕ: Отримання подій з Excel за категорією
def get_university_events(category=None):
    """Повертає загальні події. Якщо вказати категорію ('official', 'scientific'), поверне тільки їх."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    if category:
        cursor.execute("SELECT title, event_date, category FROM university_events WHERE category = ? ORDER BY event_date ASC", (category,))
    else:
        cursor.execute("SELECT title, event_date, category FROM university_events ORDER BY event_date ASC")
        
    data = cursor.fetchall()
    conn.close()
    return data

def add_event(student_id, subject_id, event_type, title, event_date):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('''
        INSERT INTO events (student_id, subject_id, event_type, title, event_date, is_completed)
        VALUES (?, ?, ?, ?, ?, 0)
    ''', (student_id, subject_id, event_type, title, event_date))
    conn.commit()
    conn.close()
    print(f"Event '{title}' added successfully!")

